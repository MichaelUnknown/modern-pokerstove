{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with apps and tests",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "MODERN_POKERSTOVE_BUILD_APPS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "debug",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "core",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "MODERN_POKERSTOVE_BUILD_APPS": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "shared",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "python",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/python",
      "cacheVariables": {
        "MODERN_POKERSTOVE_BUILD_APPS": false,
        "MODERN_POKERSTOVE_BUILD_PYTHON": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Release"
    },
    {
      "name": "shared",
      "configurePreset": "shared",
      "configuration": "Release"
    },
    {
      "name": "python",
      "configurePreset": "python",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shared",
      "configurePreset": "shared",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "python",
      "configurePreset": "python",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
