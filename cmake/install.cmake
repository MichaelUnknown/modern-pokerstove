# PackageProject owns target exports, dependency discovery and version files.
# Each binary component has its own package; pokerstove brings both into scope.
packageProject(NAME peval VERSION ${PROJECT_VERSION}
    NAMESPACE pokerstove BINARY_DIR ${PROJECT_BINARY_DIR}
    INCLUDE_DIR ${PROJECT_SOURCE_DIR}/include
    INCLUDE_DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
    DISABLE_VERSION_SUFFIX YES RUNTIME_DESTINATION "/"
    COMPATIBILITY SameMajorVersion)
packageProject(NAME penum VERSION ${PROJECT_VERSION}
    NAMESPACE pokerstove BINARY_DIR ${PROJECT_BINARY_DIR}
    INCLUDE_DIR ${PROJECT_SOURCE_DIR}/include
    INCLUDE_DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
    DEPENDENCIES "peval ${PROJECT_VERSION} CONFIG"
    DISABLE_VERSION_SUFFIX YES RUNTIME_DESTINATION "/"
    COMPATIBILITY SameMajorVersion)
packageProject(NAME pokerstove VERSION ${PROJECT_VERSION}
    NAMESPACE pokerstove BINARY_DIR ${PROJECT_BINARY_DIR}
    INCLUDE_DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
    DEPENDENCIES "peval ${PROJECT_VERSION} CONFIG;penum ${PROJECT_VERSION} CONFIG"
    DISABLE_VERSION_SUFFIX YES ARCH_INDEPENDENT NO
    COMPATIBILITY SameMajorVersion)
install(FILES ${PROJECT_SOURCE_DIR}/LICENSE.txt
    DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/pokerstove
    COMPONENT pokerstove_Development)
