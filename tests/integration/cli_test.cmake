function(run_cli program expected_status)
    execute_process(COMMAND "${program}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${program} ${ARGN}: status ${status}, expected ${expected_status}\n${output}\n${error}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

foreach(program IN ITEMS "${PS_EVAL}" "${PS_COLEX}" "${PS_LUT}")
    run_cli("${program}" 1)
    run_cli("${program}" 1 --help)
    if(NOT cli_output MATCHES "--help")
        message(FATAL_ERROR "Missing help option in help output")
    endif()
    run_cli("${program}" 1 -?)
    run_cli("${program}" 1 --unknown-option)
endforeach()

set(board "2c3d4h5s9c")
run_cli("${PS_EVAL}" 0 AcAs KhKd --board "${board}")
set(expected "The hand AcAs has 100 % equity (1 0 0 0)\nThe hand KhKd has 0 % equity (0 0 0 0)\n")
if(NOT cli_output STREQUAL expected)
    message(FATAL_ERROR "Unexpected positional evaluation: ${cli_output}")
endif()
run_cli("${PS_EVAL}" 0 -g h -h AcAs -h KhKd -b "${board}")
if(NOT cli_output STREQUAL expected)
    message(FATAL_ERROR "Named/repeated hands changed evaluation")
endif()
run_cli("${PS_EVAL}" 0 --game=h --hand=AcAs --board=${board} -- KhKd)
if(NOT cli_output STREQUAL expected)
    message(FATAL_ERROR "Mixed named/positional hands changed evaluation")
endif()
run_cli("${PS_EVAL}" 0 -q AcAs KhKd -b "${board}")
if(NOT cli_output STREQUAL "")
    message(FATAL_ERROR "Quiet evaluation produced output")
endif()
run_cli("${PS_EVAL}" 0 "AcAs=0.25,AdAh=0.75" KhKd -b "${board}")
if(NOT cli_output MATCHES "The hand AcAs=0.25,AdAh=0.75 has 100 % equity")
    message(FATAL_ERROR "Comma-separated range split into player arguments: ${cli_output}")
endif()
run_cli("${PS_EVAL}" 0 -h "AcAs=0.25,AdAh=0.75" -h KhKd -b "${board}")
if(NOT cli_output MATCHES "The hand AcAs=0.25,AdAh=0.75 has 100 % equity")
    message(FATAL_ERROR "Named comma-separated range split into player arguments")
endif()
run_cli("${PS_EVAL}" 1 -q)
run_cli("${PS_EVAL}" 1 AcAs KhKd --game=unsupported)
run_cli("${PS_EVAL}" 1 AcAs=invalid KhKd)
run_cli("${PS_EVAL}" 1 --board)
run_cli("${PS_EVAL}" 1 AcAs KhKd -g h -g h)
run_cli("${PS_EVAL}" 1 -- -?)

run_cli("${PS_COLEX}" 0 -n 1)
if(NOT cli_output MATCHES "2c: 0\n3c: 1")
    message(FATAL_ERROR "Unexpected canonical colex output")
endif()
run_cli("${PS_COLEX}" 0 --num-cards=1 --ranks)
if(NOT cli_output MATCHES "2: 0\n3: 1")
    message(FATAL_ERROR "Unexpected rank colex output")
endif()
run_cli("${PS_COLEX}" 0 --ranks)
run_cli("${PS_COLEX}" 1 --num-cards)
run_cli("${PS_COLEX}" 1 -n invalid)
run_cli("${PS_COLEX}" 1 -n -1)
run_cli("${PS_COLEX}" 1 -n 53)
run_cli("${PS_COLEX}" 1 unexpected-positional)
run_cli("${PS_COLEX}" 1 -n 1 -n 2)

run_cli("${PS_LUT}" 0 -g h -p 1 -b 1)
set(expected "${cli_output}")
run_cli("${PS_LUT}" 0 --game=h --pocket-count=1 --board-count=1)
if(NOT cli_output STREQUAL expected)
    message(FATAL_ERROR "Short/long LUT options changed output")
endif()
run_cli("${PS_LUT}" 0 -g h -p 1 -b 1 --ranks)
run_cli("${PS_LUT}" 1 -p)
run_cli("${PS_LUT}" 1 -p invalid)
run_cli("${PS_LUT}" 1 -b -1)
run_cli("${PS_LUT}" 1 -p 53)
run_cli("${PS_LUT}" 1 -b 53)
run_cli("${PS_LUT}" 1 -g invalid)
run_cli("${PS_LUT}" 1 unexpected-positional)
